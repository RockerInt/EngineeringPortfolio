{
  // Static-assets-only Worker: Cloudflare serves ./dist directly, no server code and no Astro adapter.
  "name": "jonathan-jimenez-portfolio",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
