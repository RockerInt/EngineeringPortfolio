---
import Base from '@/layouts/Base.astro';
import { href, t } from '@/i18n';

// A static 404 cannot know the visitor's language, so it shows both.
const en = t('en').notFound;
const es = t('es').notFound;
---

<Base lang="en" title={en.title}>
  <section class="section">
    <div class="container nf">
      <p class="num code" aria-hidden="true">{en.code}</p>
      <h1>{en.heading}</h1>
      <p class="lead">{en.text}</p>
      <p class="lead" lang="es">{es.heading} {es.text}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={href('en', 'home')}>{en.home}</a>
        <a class="btn" href={href('es', 'home')} lang="es" hreflang="es">{es.home}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  h1 {
    text-wrap: balance;
  }

  .code {
    font-size: var(--text-xl);
    color: var(--color-muted);
  }

  .lead {
    color: var(--color-ink-2);
  }
</style>
