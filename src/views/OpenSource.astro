---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ExtLink from '@/components/ExtLink.astro';
import Status from '@/components/Status.astro';
import ContactCta from '@/components/ContactCta.astro';
import { t, type Lang } from '@/i18n';
import { getProjects, projectHref, slugOf } from '@/lib/content';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const o = d.openSource;
// Curated: only projects with a public repository, each linking to its single canonical page.
const repos = (await getProjects(lang)).filter((p) => p.data.repo);
---

<Base lang={lang} page="openSource" title={o.title} description={o.description}>
  <PageHero lang={lang} label={o.label} heading={o.heading} lead={o.lead} />

  <section class="section">
    <div class="container">
      <ol class="repos register">
        {
          repos.map((project, i) => (
            <li class="repo">
              <div class="side">
                <p class="num idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                <p class="num path">RockerInt/<span>{new URL(project.data.repo!).pathname.split('/')[2]}</span></p>
                <dl class="spec">
                  <div>
                    <dt>{d.common.type}</dt>
                    <dd>{project.data.category}</dd>
                  </div>
                  <div>
                    <dt>{d.common.status}</dt>
                    <dd><Status project={project} lang={lang} /></dd>
                  </div>
                  {project.data.license && (
                    <div>
                      <dt>{d.common.license}</dt>
                      <dd>{project.data.license}</dd>
                    </div>
                  )}
                </dl>
              </div>
              <div class="body">
                <h2><a href={projectHref(lang, project)}>{project.data.title}</a></h2>
                <p class="summary">{project.data.summary}</p>
                <div class="why">
                  <h3>{o.demonstrates}</h3>
                  <p>{o.notes[slugOf(project.id)]}</p>
                </div>
                <ul class="tags" aria-label={d.common.stack}>
                  {project.data.stack.map((s) => <li class="tag">{s}</li>)}
                </ul>
                <p class="links">
                  <a class="link" href={projectHref(lang, project)} aria-label={`${d.common.caseStudy}: ${project.data.title}`}>
                    {d.common.caseStudy}
                  </a>
                  <ExtLink href={project.data.repo!} lang={lang} class="link">{d.common.repository}</ExtLink>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="more"><ExtLink href={SITE.github} lang={lang} class="btn">{o.allRepos}</ExtLink></p>
    </div>
  </section>

  <ContactCta lang={lang} />
</Base>

<style>
  .repo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg) var(--gap-columns);
    padding-block: var(--space-2xl);
  }

  .repo:first-child {
    padding-top: var(--space-lg);
  }

  .side {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .idx {
    font-size: var(--text-xl);
  }

  .path {
    color: var(--color-ink-2);
    overflow-wrap: anywhere;
  }

  .body {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  h2 {
    max-width: none;
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .summary {
    font-size: var(--text-lead);
    color: var(--color-ink-2);
  }

  .why {
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule-2);
  }

  .why h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .why p {
    margin-top: var(--space-2xs);
  }

  @media (min-width: 60rem) {
    .repo {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
