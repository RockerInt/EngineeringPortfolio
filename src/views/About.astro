---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Background from '@/components/Background.astro';
import Portrait from '@/components/Portrait.astro';
import ContactCta from '@/components/ContactCta.astro';
import { href, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
---

<Base lang={lang} page="about" title={a.title} description={a.description}>
  <PageHero lang={lang} label={a.label} heading={a.heading}>
    <Portrait slot="aside" lang={lang} sizes="(min-width: 60rem) 26vw, 20rem" eager />
  </PageHero>

  <Section label={d.home.intro.label}>
    <div class="intro">
      {a.intro.map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
    </div>
  </Section>

  <Section label={a.pathLabel} title={a.pathTitle} band>
    <ol class="path register">
      {
        a.path.map((step) => (
          <li>
            <p class="num">{step.period}</p>
            <h3>{step.title}</h3>
            <p class="text">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="more"><a class="link" href={href(lang, 'experience')}>{a.cta}</a></p>
  </Section>

  <Section label={a.philosophyLabel} title={a.philosophyTitle}>
    <ol class="principles">
      {
        a.philosophy.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p class="text">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section label={a.backgroundLabel}>
    <Background lang={lang} />
  </Section>

  <ContactCta lang={lang} />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg) var(--gap-columns);
  }

  .intro p {
    max-width: none;
    font-size: var(--text-lead);
    color: var(--color-ink-2);
  }

  /* The opening sentence is the section: a statement across the sheet. */
  .intro .first {
    font-size: var(--text-section);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .intro p + p {
    max-width: 60ch;
  }

  .path li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs) var(--gap-columns);
    padding-block: var(--space-lg);
    align-items: baseline;
  }

  .text {
    color: var(--color-ink-2);
  }

  /* Four principles on one line of the sheet, parted by keylines. */
  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  .principles li {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
  }

  @media (min-width: 60rem) {
    .path li {
      grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) minmax(0, 6fr);
    }

    .principles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .principles li {
      padding: var(--space-lg);
      border-bottom: 0;
      border-left: var(--rule-hair) solid var(--color-rule-2);
    }

    .principles li:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .principles li:last-child {
      padding-right: 0;
    }
  }
</style>
