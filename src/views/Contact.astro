---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import { t, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
// Only confirmed channels, in the same order as `contact.channels` in the dictionaries. No phone is published.
const urls = [`mailto:${SITE.email}`, SITE.linkedin, SITE.github];
const isExternal = (url: string) => url.startsWith('http');
---

<Base lang={lang} page="contact" title={c.title} description={c.description}>
  <PageHero lang={lang} label={c.label} heading={c.heading} lead={c.lead} />

  <div class="container">
    <ul class="channels">
      {
        c.channels.map((channel, i) => (
          <li class="rise" style={`--i:${i + 3}`}>
            <a href={urls[i]} target={isExternal(urls[i]!) ? '_blank' : undefined} rel={isExternal(urls[i]!) ? 'noopener noreferrer' : undefined}>
              <span class="mono">{channel.handle}</span>
              <span class="name">{channel.name}</span>
              <span class="muted">{channel.text}</span>
              <ArrowUpRight aria-hidden="true" />
              {isExternal(urls[i]!) && <span class="sr-only">{d.common.externalHint}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <Section label={c.forLabel}>
    <ul class="reasons">
      {c.for.map((item) => <li class="reveal">{item}</li>)}
    </ul>
    <p class="mono place reveal">{d.location}</p>
  </Section>
</Base>

<style>
  .channels {
    display: grid;
    gap: 1rem;
    padding-bottom: var(--space-section);
  }

  .channels a {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color var(--fast) var(--ease);
  }

  .channels a:hover {
    border-color: var(--accent);
  }

  .mono {
    text-transform: none;
    letter-spacing: 0;
  }

  .name {
    margin-top: 1.5rem;
    font-size: var(--text-3xl);
    font-weight: 600;
    overflow-wrap: anywhere;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .channels :global(svg) {
    position: absolute;
    top: clamp(1.5rem, 4vw, 2.5rem);
    right: clamp(1.5rem, 4vw, 2.5rem);
    width: 1.5rem;
    height: 1.5rem;
    color: var(--muted);
    transition: transform var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .channels a:hover :global(svg) {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Email is the primary channel: it spans the full row. */
    .channels li:first-child {
      grid-column: 1 / -1;
    }
  }

  .reasons {
    border-top: 1px solid var(--border-strong);
  }

  .reasons li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-lg);
  }

  .place {
    margin-top: 2rem;
  }
</style>
