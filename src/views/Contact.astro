---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import { t, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
// Only confirmed channels, in the same order as `contact.channels` in the dictionaries. No phone is published.
const urls = [`mailto:${SITE.email}`, SITE.linkedin, SITE.github];
const isExternal = (url: string) => url.startsWith('http');
---

<Base lang={lang} page="contact" title={c.title} description={c.description}>
  <PageHero lang={lang} label={c.label} heading={c.heading} lead={c.lead} />

  <section class="section">
    <div class="container">
      <ul class="channels register">
        {
          c.channels.map((channel, i) => (
            <li>
              <a href={urls[i]} target={isExternal(urls[i]!) ? '_blank' : undefined} rel={isExternal(urls[i]!) ? 'noopener noreferrer' : undefined}>
                <span class="name">{channel.name}</span>
                <span class="handle">{channel.handle}</span>
                <span class="text">{channel.text}</span>
                {isExternal(urls[i]!) && <ArrowUpRight aria-hidden="true" />}
                {isExternal(urls[i]!) && <span class="sr-only">{d.common.externalHint}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Section label={c.forLabel} band>
    <ul class="reasons register">
      {c.for.map((item) => <li>{item}</li>)}
    </ul>
    <p class="label place">{d.location}</p>
  </Section>
</Base>

<style>
  .channels a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2xs) var(--gap-columns);
    align-items: baseline;
    padding: var(--space-md);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .channels a:hover {
    background: var(--color-paper-3);
  }

  .channels a:active {
    background: var(--color-paper-2);
  }

  .name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }

  .handle {
    grid-column: 1;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    overflow-wrap: anywhere;
  }

  /* On a phone the address must stay on one line: it is the thing to copy. */
  @media (max-width: 40rem) {
    .handle {
      font-size: var(--text-md);
    }
  }

  .text {
    grid-column: 1;
    color: var(--color-ink-2);
  }

  .channels :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    width: 24px;
    height: 24px;
  }

  .reasons li {
    padding-block: var(--space-lg);
    font-size: var(--text-lead);
  }

  .place {
    margin-top: var(--space-lg);
  }

  @media (min-width: 60rem) {
    .channels a {
      grid-template-columns: minmax(0, 2fr) minmax(0, 6fr) minmax(0, 3fr) minmax(0, 1fr);
      padding-block: var(--space-lg);
    }

    .handle,
    .text {
      grid-column: auto;
    }

    .channels :global(svg) {
      grid-column: 4;
      grid-row: auto;
      justify-self: end;
    }
  }
</style>
