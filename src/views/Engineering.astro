---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import WorkRow from '@/components/WorkRow.astro';
import ContactCta from '@/components/ContactCta.astro';
import ArchDiagram from '@/components/ArchDiagram.astro';
import { t, type Lang } from '@/i18n';
import { getProjects } from '@/lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const e = d.engineering;
const cases = await getProjects(lang, 'engineering');
// Applications built on the framework keep their canonical page under Open Source.
const related = (await getProjects(lang, 'openSource')).filter((p) => p.data.repo);
---

<Base lang={lang} page="engineering" title={e.title} description={e.description}>
  <PageHero lang={lang} label={e.label} heading={e.heading} lead={e.lead} />

  <Section label={e.casesLabel}>
    <ul class="register">
      {cases.map((project, i) => <WorkRow project={project} lang={lang} index={i + 1} />)}
    </ul>
    <div class="drawing"><ArchDiagram lang={lang} /></div>
  </Section>

  <Section label={e.focusLabel} band>
    <dl class="focus">
      {
        e.focus.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section label={e.relatedLabel} title={e.relatedText}>
    <ul class="related register">
      {related.map((project, i) => <WorkRow project={project} lang={lang} index={i + 1} />)}
    </ul>
  </Section>

  <ContactCta lang={lang} />
</Base>

<style>
  .drawing {
    margin-top: var(--space-2xl);
  }

  .focus {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  .focus > div {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
  }

  dt {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-display);
  }

  dd {
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .focus {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .focus > div {
      padding: var(--space-lg);
      border-bottom: 0;
      border-left: var(--rule-hair) solid var(--color-rule-2);
    }

    .focus > div:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .focus > div:last-child {
      padding-right: 0;
    }
  }
</style>
