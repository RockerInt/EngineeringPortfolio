---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import WorkRow from '@/components/WorkRow.astro';
import ContactCta from '@/components/ContactCta.astro';
import { t, type Lang } from '@/i18n';
import { getProjects } from '@/lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const e = d.engineering;
const cases = await getProjects(lang, 'engineering');
// Applications built on the framework keep their canonical page under Open Source.
const related = (await getProjects(lang, 'openSource')).filter((p) => p.data.repo);
---

<Base lang={lang} page="engineering" title={e.title} description={e.description}>
  <PageHero lang={lang} label={e.label} heading={e.heading} lead={e.lead} />

  <Section label={e.casesLabel}>
    <ul>
      {cases.map((project, i) => <WorkRow project={project} lang={lang} index={i + 1} />)}
    </ul>
  </Section>

  <Section label={e.focusLabel}>
    <dl class="focus">
      {
        e.focus.map((item) => (
          <div class="reveal">
            <dt>{item.title}</dt>
            <dd class="muted">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section label={e.relatedLabel}>
    <p class="lead reveal">{e.relatedText}</p>
    <ul class="related">
      {related.map((project, i) => <WorkRow project={project} lang={lang} index={i + 1} />)}
    </ul>
  </Section>

  <ContactCta lang={lang} />
</Base>

<style>
  .focus {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  .focus > div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-strong);
  }

  dt {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  dd {
    margin-top: 0.75rem;
  }

  @media (min-width: 44rem) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .related {
    margin-top: 2.5rem;
  }
</style>
