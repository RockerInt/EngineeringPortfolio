---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import WorkRow from '@/components/WorkRow.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import Timeline from '@/components/Timeline.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import ContactCta from '@/components/ContactCta.astro';
import Portrait from '@/components/Portrait.astro';
import { href, t, type Lang } from '@/i18n';
import ArchDiagram from '@/components/ArchDiagram.astro';
import Status from '@/components/Status.astro';
import ExtLink from '@/components/ExtLink.astro';
import { getProjects, projectHref, slugOf } from '@/lib/content';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const engineering = (await getProjects(lang)).filter((p) => p.data.featured && p.data.section !== 'digital');
// The framework leads the engineering chapter with its diagram; the rest follow as rows.
const lead = engineering.find((p) => slugOf(p.id) === 'dsr-architecture');
const rows = engineering.filter((p) => p !== lead);
const digital = await getProjects(lang, 'digital');
const A = d.areas.engineering;
const B = d.areas.digital;
---

<Base lang={lang} page="home" title={h.title} description={h.description}>
  <section class="hero night">
    <div class="container grid">
      <h1>{d.statement[0]}<br />{d.statement[1]}</h1>
      <div class="pitch">
        <p class="lead">{d.valueProp}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#work">{h.cta.work}</a>
          <a class="btn" href={href(lang, 'resume')}>{h.cta.resume}</a>
          <a class="link" href={href(lang, 'contact')}>{h.cta.contact}</a>
        </div>
      </div>
      <div class="block">
        <p class="who"><span class="name">{SITE.name}</span><span>{d.role}</span></p>
        <dl class="spec" aria-label={h.spec.label}>
          {
            h.spec.rows.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section band" id="work">
    <div class="container">
      <header class="head">
        <h2>{h.work.label}</h2>
        <p class="lead">{h.work.title} {h.areasNote}</p>
      </header>

      <div class="chapter">
        <header class="chapter-head">
          <div>
            <h3>{A.title}</h3>
            <p>{A.text}</p>
          </div>
          <a class="link" href={href(lang, 'engineering')}>{A.cta}</a>
        </header>

        {
          lead && (
            <article class="flagship">
              <div class="lead-text">
                <div>
                  <h4><a href={projectHref(lang, lead)}>{lead.data.title}</a></h4>
                  <p class="summary">{lead.data.summary}</p>
                  <p class="links">
                    <a class="link" href={projectHref(lang, lead)} aria-label={`${d.common.caseStudy}: ${lead.data.title}`}>
                      {d.common.caseStudy}
                    </a>
                    {lead.data.repo && <ExtLink href={lead.data.repo} lang={lang} class="link">{d.common.repository}</ExtLink>}
                  </p>
                </div>
                <dl class="spec">
                  <div>
                    <dt>{d.common.type}</dt>
                    <dd>{lead.data.category}</dd>
                  </div>
                  <div>
                    <dt>{d.common.status}</dt>
                    <dd><Status project={lead} lang={lang} /></dd>
                  </div>
                  <div>
                    <dt>{d.common.stack}</dt>
                    <dd>{lead.data.stack.slice(0, 5).join(', ')}</dd>
                  </div>
                </dl>
              </div>
              <ArchDiagram lang={lang} />
            </article>
          )
        }
        <ul class="rows register">
          {rows.map((project, i) => <WorkRow project={project} lang={lang} index={i + 2} level={4} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container chapter">
      <header class="chapter-head">
        <div>
          <h3>{B.title}</h3>
          <p>{B.text}</p>
        </div>
        <a class="link" href={href(lang, 'digital')}>{B.cta}</a>
      </header>

      <div class="set">
        {digital.map((project) => <WorkFeature project={project} lang={lang} level={4} />)}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container profile">
      <Portrait lang={lang} sizes="(min-width: 60rem) 28vw, 70vw" />
      <div>
        <h2>{h.intro.label}</h2>
        <p class="lead">{h.intro.lead}</p>
        {h.intro.body.map((p) => <p class="body">{p}</p>)}
        <p class="more"><a class="link" href={href(lang, 'about')}>{h.intro.link}</a></p>
      </div>
    </div>
  </section>

  <Section label={h.experience.label} title={h.experience.title}>
    <Timeline lang={lang} compact />
    <p class="more"><a class="link" href={href(lang, 'experience')}>{h.experience.link}</a></p>
  </Section>

  <Section label={h.expertise.label} title={h.expertise.title}>
    <SkillGroups lang={lang} />
    <p class="label note">{h.expertise.note}</p>
  </Section>

  <ContactCta lang={lang} />
</Base>

<style>
  /* Banner: the head, one sentence and the actions, with the sheet's title block beside them. */
  .hero {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-3xl);
    align-items: start;
  }

  h1 {
    max-width: none;
    text-wrap: balance;
  }

  .pitch .lead {
    color: var(--color-ink-2);
  }

  .pitch .btn-row {
    margin-top: var(--space-xl);
  }

  .who {
    display: grid;
    gap: var(--space-2xs);
    max-width: none;
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-bottom: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .who .name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }

    .grid h1 {
      grid-column: 1 / -1;
    }
  }

  /* Chapters */
  .chapter-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-md) var(--gap-columns);
    margin-bottom: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  .chapter-head h3 {
    font-size: var(--text-head);
    line-height: 1.1;
  }

  .chapter-head p {
    margin-top: var(--space-sm);
    color: var(--color-ink-2);
  }

  .flagship {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  .lead-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg) var(--space-3xl);
    align-items: end;
  }

  .lead-text .summary {
    margin-top: var(--space-sm);
    max-width: 52ch;
    font-size: var(--text-lead);
  }

  .lead-text .links {
    margin-top: var(--space-lg);
  }

  .lead-text :global(.status) {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
  }

  .lead-text h4 {
    font-size: var(--text-head);
    line-height: 1.1;
  }

  .lead-text h4 a {
    text-decoration: none;
  }

  .lead-text h4 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .summary {
    color: var(--color-ink-2);
  }

  .rows {
    margin-top: var(--space-2xl);
  }

  /* Three sites, one set: equal frames across the sheet. */
  .set {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl) var(--gap-columns);
  }

  @media (min-width: 60rem) {
    .lead-text {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .set {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Profile */
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--space-3xl);
    align-items: center;
  }

  .profile .lead {
    margin-top: var(--space-lg);
    font-size: var(--text-2xl);
    line-height: 1.25;
    max-width: 28ch;
  }

  .profile .body {
    margin-top: var(--space-md);
    max-width: 60ch;
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .profile {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }

  .note {
    margin-top: var(--space-lg);
  }
</style>
