---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import WorkRow from '@/components/WorkRow.astro';
import WorkFeature from '@/components/WorkFeature.astro';
import Timeline from '@/components/Timeline.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import ContactCta from '@/components/ContactCta.astro';
import Portrait from '@/components/Portrait.astro';
import { href, t, type Lang } from '@/i18n';
import ArchDiagram from '@/components/ArchDiagram.astro';
import Status from '@/components/Status.astro';
import ExtLink from '@/components/ExtLink.astro';
import { getProjects, projectHref, slugOf } from '@/lib/content';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const engineering = (await getProjects(lang)).filter((p) => p.data.featured && p.data.section !== 'digital');
// The framework leads the engineering chapter with its diagram; the rest follow as rows.
const lead = engineering.find((p) => slugOf(p.id) === 'dsr-architecture');
const rows = engineering.filter((p) => p !== lead);
const [digitalLead, ...digitalRest] = await getProjects(lang, 'digital');
const A = d.areas.engineering;
const B = d.areas.digital;
---

<Base lang={lang} page="home" title={h.title} description={h.description}>
  <section class="hero">
    <div class="container">
      <h1 class="id rise">
        <span class="name">{SITE.name}</span>
        <span class="mono role">{d.role}</span>
      </h1>

      <p class="statement">
        <span class="line rise" style="--i:1"><sup class="mono" aria-hidden="true">A</sup>{d.statement[0]}</span>
        <span class="line second rise" style="--i:2"><sup class="mono" aria-hidden="true">B</sup>{d.statement[1]}</span>
      </p>

      <div class="foot">
        <div class="pitch rise" style="--i:3">
          <p class="lead">{d.valueProp}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="#work">{h.cta.work}<ArrowRight aria-hidden="true" /></a>
            <a class="link" href={href(lang, 'resume')}>{h.cta.resume}</a>
            <a class="link" href={href(lang, 'contact')}>{h.cta.contact}</a>
          </div>
        </div>
        <dl class="spec rise" style="--i:4" aria-label={h.spec.label}>
          {
            h.spec.rows.map(([term, value]) => (
              <div>
                <dt class="mono">{term}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <Section label={h.intro.label}>
    <div slot="rail" class="intro-portrait reveal"><Portrait lang={lang} sizes="(min-width: 60rem) 16rem, 11rem" /></div>
    <p class="intro-lead reveal">{h.intro.lead}</p>
    <div class="intro-body">
      {h.intro.body.map((p) => <p class="muted reveal">{p}</p>)}
    </div>
    <p class="reveal more"><a class="link" href={href(lang, 'about')}>{h.intro.link}<ArrowRight aria-hidden="true" /></a></p>
  </Section>

  <section class="section" id="work">
    <div class="container">
      <header class="section-grid">
        <p class="section-label mono">{h.work.label}</p>
        <div>
          <h2 class="section-title reveal">{h.work.title}</h2>
          <p class="muted work-note reveal">{h.areasNote}</p>
        </div>
      </header>

      <div class="chapter">
        <header class="chapter-head reveal">
          <p class="mono letter" aria-hidden="true">A</p>
          <div>
            <h3>{A.title}</h3>
            <p class="muted">{A.text}</p>
          </div>
          <p class="all"><a class="link" href={href(lang, 'engineering')}>{A.cta}<ArrowRight aria-hidden="true" /></a></p>
        </header>

        {
          lead && (
            <article class="flagship">
              <ArchDiagram lang={lang} />
              <div class="lead-text reveal">
                <p class="mono">01 — {lead.data.category}</p>
                <h4><a href={projectHref(lang, lead)}>{lead.data.title}</a></h4>
                <p class="muted">{lead.data.summary}</p>
                <p><Status project={lead} lang={lang} /></p>
                <p class="mono stack">{lead.data.stack.slice(0, 5).join(' · ')}</p>
                <p class="links">
                  <a class="link" href={projectHref(lang, lead)} aria-label={`${d.common.caseStudy}: ${lead.data.title}`}>
                    {d.common.caseStudy}<ArrowRight aria-hidden="true" />
                  </a>
                  {lead.data.repo && <ExtLink href={lead.data.repo} lang={lang} class="link">{d.common.repository}</ExtLink>}
                </p>
              </div>
            </article>
          )
        }
        <ul class="rows">
          {rows.map((project, i) => <WorkRow project={project} lang={lang} index={i + 2} level={4} />)}
        </ul>
      </div>

      <div class="chapter digital">
        <header class="chapter-head reveal">
          <p class="mono letter" aria-hidden="true">B</p>
          <div>
            <h3>{B.title}</h3>
            <p class="muted">{B.text}</p>
          </div>
          <p class="all"><a class="link" href={href(lang, 'digital')}>{B.cta}<ArrowRight aria-hidden="true" /></a></p>
        </header>

        <div>{digitalLead && <WorkFeature project={digitalLead} lang={lang} wide level={4} />}</div>
        <div class="pair">
          {digitalRest.map((project) => <WorkFeature project={project} lang={lang} level={4} />)}
        </div>
      </div>
    </div>
  </section>

  <Section label={h.experience.label} title={h.experience.title}>
    <Timeline lang={lang} compact />
    <p class="more reveal"><a class="link" href={href(lang, 'experience')}>{h.experience.link}<ArrowRight aria-hidden="true" /></a></p>
  </Section>

  <Section label={h.expertise.label} title={h.expertise.title}>
    <SkillGroups lang={lang} />
    <p class="muted note reveal">{h.expertise.note}</p>
  </Section>

  <ContactCta lang={lang} />
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }

  .id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .id .role {
    color: var(--muted);
  }

  .statement {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 620;
  }

  .line {
    display: block;
    position: relative;
  }

  .second {
    font-weight: 300;
    color: #b9c4d4;
    margin-top: 0.08em;
  }

  .line sup {
    position: absolute;
    right: 100%;
    top: 0.9em;
    margin-right: 0.9rem;
    font-size: var(--text-xs);
    letter-spacing: 0;
    color: var(--accent);
  }

  .second sup {
    color: var(--warm);
  }

  /* The A/B markers live in the page margin; hide them when there is no margin to hold them. */
  @media (max-width: 86rem) {
    .line sup {
      display: none;
    }
  }

  .foot {
    display: grid;
    gap: 3rem var(--col-gap);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pitch {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .pitch .btn-row {
    align-items: center;
    gap: 1rem 1.75rem;
    font-size: var(--text-sm);
  }

  .pitch .lead {
    color: var(--text);
    max-width: 44ch;
  }

  @media (min-width: 60rem) {
    .foot {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  /* ----- Intro ----- */
  .intro-portrait {
    max-width: 11rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 60rem) {
    .intro-portrait {
      max-width: 16rem;
    }
  }

  .intro-lead {
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 500;
    max-width: 24ch;
  }

  .intro-body {
    display: grid;
    gap: 1.5rem var(--col-gap);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 48rem) {
    .intro-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .more {
    margin-top: 2.5rem;
    font-size: var(--text-sm);
  }

  /* ----- Selected work: two chapters, each with its own composition ----- */
  .work-note {
    margin-top: 1.25rem;
    max-width: 52ch;
  }

  .chapter {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .digital {
    --accent: var(--warm);
  }

  .chapter-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem var(--col-gap);
    padding-block: 1.5rem clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border-strong);
  }

  .letter {
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .letter::after {
    content: ' /';
    color: var(--border-strong);
  }

  .chapter-head h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
  }

  .chapter-head .muted {
    margin-top: 0.75rem;
    max-width: 48ch;
  }

  .all {
    font-size: var(--text-sm);
  }

  .flagship {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem var(--col-gap);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .lead-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    align-content: start;
    justify-items: start;
  }

  .lead-text h4 {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
  }

  .lead-text h4 a {
    transition: color var(--fast) var(--ease);
  }

  .lead-text h4 a:hover {
    color: var(--accent);
  }

  .lead-text .stack {
    text-transform: none;
    letter-spacing: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem var(--col-gap);
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  @media (min-width: 52rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Offset the second column so the two features do not read as a card grid. */
    .pair > :global(:nth-child(even)) {
      margin-top: 5rem;
    }
  }

  @media (min-width: 60rem) {
    .chapter-head {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      align-items: start;
    }

    .all {
      justify-self: end;
      padding-top: 0.6rem;
    }

    .flagship {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .lead-text {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .note {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
    max-width: 60ch;
  }
</style>
