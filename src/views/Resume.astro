---
import Download from '@lucide/astro/icons/download';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Timeline from '@/components/Timeline.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import Background from '@/components/Background.astro';
import { LANGS, t, type Lang } from '@/i18n';
import { SITE, resumeFile } from '@/lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const r = d.resume;
// A download button exists only for PDFs that are really in public/resume/.
// The current language's PDF comes first.
const downloads = [lang, ...LANGS.filter((l) => l !== lang)].flatMap((l) => {
  const file = resumeFile(l);
  return file ? [{ file, label: r.download[l] }] : [];
});
---

<Base lang={lang} page="resume" title={r.title} description={r.description}>
  <PageHero lang={lang} label={r.label} heading={SITE.name} lead={d.role}>
    <div class="actions no-print">
      {
        downloads.length > 0 ? (
          <div class="btn-row">
            {downloads.map((item, i) => (
              <a class:list={['btn', { 'btn-primary': i === 0 }]} href={item.file} download>
                <Download aria-hidden="true" />{item.label}
              </a>
            ))}
          </div>
        ) : (
          <p>
            {r.noPdf} <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        )
      }
    </div>
    <ul class="contacts">
      <li>{d.location}</li>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.linkedin}>{SITE.linkedin.replace('https://www.', '').replace(/\/$/, '')}</a></li>
      <li><a href={SITE.github}>{SITE.github.replace('https://', '')}</a></li>
      <li class="print-only">{Astro.site?.host}</li>
    </ul>
    <div slot="aside" class="sum">
      <h2>{r.summaryLabel}</h2>
      <p class="summary">{r.summary}</p>
    </div>
  </PageHero>

  <Section label={r.experienceLabel}>
    <Timeline lang={lang} level={3} />
  </Section>

  <Section label={r.skillsLabel} band>
    <SkillGroups lang={lang} />
  </Section>

  <Section label={d.about.backgroundLabel}>
    <Background lang={lang} />
  </Section>
</Base>

<style>
  .actions {
    margin-top: var(--space-xl);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .contacts a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    overflow-wrap: anywhere;
  }

  .contacts a:hover {
    text-decoration-color: transparent;
  }

  /* The summary sits in the sheet's title block, beside the name. */
  .sum {
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
  }

  .sum h2 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
    color: var(--color-muted);
    text-wrap: balance;
  }

  .summary {
    margin-top: var(--space-xs);
    color: var(--color-ink-2);
  }

  @media print {
    .sum {
      padding: 0;
      border: 0;
    }
  }
</style>
