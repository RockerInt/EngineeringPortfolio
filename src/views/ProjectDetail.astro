---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ExtLink from '@/components/ExtLink.astro';
import ModuleMap from '@/components/ModuleMap.astro';
import ArchDiagram from '@/components/ArchDiagram.astro';
import ContactCta from '@/components/ContactCta.astro';
import { href, t, type Lang } from '@/i18n';
import { getProjects, projectHref, slugOf, type Project } from '@/lib/content';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const d = t(lang);
const c = d.common;
const { data } = project;
const { Content } = await render(project);

const siblings = await getProjects(lang, data.section);
const next = siblings[(siblings.findIndex((p) => p.id === project.id) + 1) % siblings.length];
const status = [data.kind && c.kind[data.kind], data.stage && c.stage[data.stage]].filter(Boolean).join(', ');
const host = data.url ? new URL(data.url).host : undefined;
---

<Base
  lang={lang}
  page={data.section}
  sub={slugOf(project.id)}
  title={`${data.title} — ${d.nav[data.section]} — ${SITE.name}`}
  description={data.summary}
>
  <PageHero lang={lang} label={data.title} heading={data.title} lead={data.summary} parent={data.section} />

  {
    data.cover && (
      <div class="container opener">
        <figure>
          <div class="fig ticks cover">
            <Picture
              src={data.cover}
              alt={data.coverAlt ?? ''}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[640, 1024, 1600, 2200]}
              sizes="(min-width: 90rem) 82rem, 94vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {host && <figcaption class="num">{host}</figcaption>}
        </figure>
      </div>
    )
  }

  {slugOf(project.id) === 'dsr-architecture' && <div class="container opener"><ArchDiagram lang={lang} /></div>}

  <div class="container layout">
    <aside class="meta">
      <dl class="spec">
        <div>
          <dt>{c.type}</dt>
          <dd>{data.category}</dd>
        </div>
        {
          data.role && (
            <div>
              <dt>{c.role}</dt>
              <dd>{data.role}</dd>
            </div>
          )
        }
        {
          status && (
            <div>
              <dt>{c.status}</dt>
              <dd>{status}</dd>
            </div>
          )
        }
        {
          data.license && (
            <div>
              <dt>{c.license}</dt>
              <dd>{data.license}</dd>
            </div>
          )
        }
        {
          data.stack.length > 0 && (
            <div>
              <dt>{c.stack}</dt>
              <dd>
                <ul class="tags">
                  {data.stack.map((s) => <li class="tag">{s}</li>)}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
      {
        (data.url || data.repo) && (
          <div class="btn-row">
            {data.url && <ExtLink href={data.url} lang={lang} class="btn btn-primary">{c.visitSite}</ExtLink>}
            {data.repo && <ExtLink href={data.repo} lang={lang} class="btn btn-primary">{c.repository}</ExtLink>}
          </div>
        )
      }
    </aside>

    <div class="content">
      <div class="prose">
        <Content />
      </div>
      {
        data.modules.length > 0 && (
          <section class="modules">
            <h2>{c.components}</h2>
            <ModuleMap modules={data.modules} lang={lang} />
          </section>
        )
      }
    </div>
  </div>

  {
    next && next.id !== project.id && (
      <nav class="next" aria-label={c.next}>
        <a class="container" href={projectHref(lang, next)}>
          <span class="label">{c.next}</span>
          <span class="title">{next.data.title}</span>
          <span class="kind">{next.data.category}</span>
        </a>
      </nav>
    )
  }
  <p class="container back">
    <a class="link" href={href(lang, data.section)}>{c.backTo} {d.nav[data.section]}</a>
  </p>

  <ContactCta lang={lang} />
</Base>

<style>
  .opener {
    padding-top: var(--space-3xl);
  }

  /* The opening capture is a band from the top of the site, not the whole first screen. */
  @media (min-width: 60rem) {
    .cover :global(img) {
      aspect-ratio: 21 / 9;
      object-fit: cover;
      object-position: top;
    }
  }

  .opener figcaption {
    margin-top: var(--space-sm);
    color: var(--color-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl) var(--gap-columns);
    padding-block: var(--section-gap-s);
  }

  .meta {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }

  .meta .tags {
    font-size: inherit;
    color: inherit;
  }

  .modules {
    margin-top: var(--space-3xl);
  }

  .modules h2 {
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }

  .next {
    border-block: var(--rule-heavy) solid var(--color-rule);
  }

  .next a {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-xl);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .next a:hover {
    background: var(--color-paper-3);
  }

  .next a:active {
    background: var(--color-paper-2);
  }

  .next .title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-section);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-transform: var(--head-case, none);
    overflow-wrap: break-word;
  }

  .next .kind {
    color: var(--color-ink-2);
  }

  .back {
    padding-block: var(--space-xl) var(--section-gap-s);
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    .meta {
      position: sticky;
      top: var(--space-4xl);
    }
  }
</style>
