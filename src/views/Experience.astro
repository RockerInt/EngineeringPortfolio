---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Timeline from '@/components/Timeline.astro';
import ContactCta from '@/components/ContactCta.astro';
import { href, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const e = t(lang).experience;
---

<Base lang={lang} page="experience" title={e.title} description={e.description}>
  <PageHero lang={lang} label={e.label} heading={e.heading} lead={e.lead} />
  <div class="container">
    <Timeline lang={lang} />
    <p class="more"><a class="btn" href={href(lang, 'resume')}>{e.cta}<ArrowRight aria-hidden="true" /></a></p>
  </div>
  <ContactCta lang={lang} />
</Base>

<style>
  .more {
    padding-block: 1rem var(--space-section);
  }
</style>
