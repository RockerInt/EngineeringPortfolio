---
import ExtLink from './ExtLink.astro';
import LangSwitch from './LangSwitch.astro';
import { FOOTER_NAV, href, t, type Lang, type PageKey } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page, sub } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="container">
    <p class="statement">{d.statement[0]}<br />{d.statement[1]}</p>

    <div class="cols">
      <p class="id">
        <span class="name">{SITE.name}</span>
        <span>{d.role}</span>
        <span>{d.location}</span>
      </p>
      <nav aria-label={d.footer.sections}>
        <ul>
          {FOOTER_NAV.map((key) => <li><a href={href(lang, key)}>{d.nav[key]}</a></li>)}
        </ul>
      </nav>
      <ul aria-label={d.footer.elsewhere}>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><ExtLink href={SITE.github} lang={lang}>GitHub</ExtLink></li>
        <li><ExtLink href={SITE.linkedin} lang={lang}>LinkedIn</ExtLink></li>
      </ul>
    </div>

    <div class="base">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <p>{d.footer.note}</p>
      <LangSwitch lang={lang} page={page} sub={sub} />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper-3);
    border-top: var(--rule-heavy) solid var(--color-rule);
    padding-block: var(--space-3xl) var(--space-xl);
    font-size: var(--text-sm);
  }

  /* The closing statement, set at the section size. */
  .statement {
    max-width: none;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-head);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-transform: var(--head-case, none);
    overflow-wrap: break-word;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--gap-columns);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .id {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    max-width: none;
    color: var(--color-ink-2);
  }

  .name {
    font-weight: 500;
    color: var(--color-ink);
  }

  ul {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  nav ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap-columns);
  }

  li :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    white-space: nowrap;
  }

  li :global(a:hover) {
    text-decoration: underline;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule-2);
    color: var(--color-muted);
  }

  .base p:nth-child(2) {
    margin-right: auto;
  }

  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    }
  }
</style>
