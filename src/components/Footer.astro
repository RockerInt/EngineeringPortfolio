---
import ExtLink from './ExtLink.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV, href, t, type Lang, type PageKey } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page, sub } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="container grid">
    <div class="id">
      <p class="name">{SITE.name}</p>
      <p class="muted">{d.role}</p>
      <p class="statement mono">{d.statement.join(' ')}</p>
    </div>

    <nav aria-label={d.footer.sections}>
      <p class="mono head">{d.footer.sections}</p>
      <ul class="cols">
        {NAV.map((key) => <li><a href={href(lang, key)}>{d.nav[key]}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="mono head">{d.footer.elsewhere}</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><ExtLink href={SITE.github} lang={lang}>GitHub</ExtLink></li>
        <li><ExtLink href={SITE.linkedin} lang={lang}>LinkedIn</ExtLink></li>
      </ul>
    </div>
  </div>

  <div class="container base">
    <p class="muted">© {new Date().getFullYear()} {SITE.name} · {d.location}</p>
    <p class="muted note">{d.footer.note}</p>
    <LangSwitch lang={lang} page={page} sub={sub} />
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    }
  }

  .name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .statement {
    margin-top: 1.25rem;
  }

  .head {
    margin-bottom: 0.9rem;
  }

  ul {
    display: grid;
    gap: 0.55rem;
  }

  .cols {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  li a {
    color: var(--muted);
    transition: color var(--fast) var(--ease);
  }

  li a:hover {
    color: var(--text);
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .note {
    margin-right: auto;
  }
</style>
