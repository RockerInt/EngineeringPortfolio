---
import ExtLink from './ExtLink.astro';
import LangSwitch from './LangSwitch.astro';
import { FOOTER_NAV, href, t, type Lang, type PageKey } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page, sub } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="container top">
    <p class="id">
      <span class="name">{SITE.name}</span>
      <span class="muted">{d.role}</span>
    </p>
    <nav aria-label={d.footer.sections}>
      <ul>
        {FOOTER_NAV.map((key) => <li><a href={href(lang, key)}>{d.nav[key]}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container base">
    <p class="muted note">© {new Date().getFullYear()} {SITE.name} · {d.location} · {d.footer.note}</p>
    <ul aria-label={d.footer.elsewhere}>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><ExtLink href={SITE.github} lang={lang}>GitHub</ExtLink></li>
      <li><ExtLink href={SITE.linkedin} lang={lang}>LinkedIn</ExtLink></li>
    </ul>
    <LangSwitch lang={lang} page={page} sub={sub} />
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    font-size: var(--text-sm);
  }

  .top,
  .base,
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.75rem;
  }

  .top {
    justify-content: space-between;
  }

  .id {
    display: grid;
    gap: 0.15rem;
  }

  .name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  li a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--muted);
    transition: color var(--fast) var(--ease);
  }

  li a:hover {
    color: var(--text);
  }

  .base {
    align-items: center;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .note {
    margin-right: auto;
  }
</style>
