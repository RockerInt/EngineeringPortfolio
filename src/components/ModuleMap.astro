---
import { t, type Lang } from '@/i18n';
import type { Project } from '@/lib/content';

interface Props {
  modules: Project['data']['modules'];
  lang: Lang;
}

const { modules, lang } = Astro.props;
const d = t(lang).common;
const groups = Object.entries(Object.groupBy(modules, (m) => m.group));
---

<div class="map">
  {
    groups.map(([group, items = []]) => (
      <section class:list={['layer', { planned: items.every((m) => m.planned) }]}>
        <h3>{group}</h3>
        <ul>
          {items.map((m) => (
            <li>
              <p class="num name">{m.name}</p>
              <p class="text">{m.description}</p>
              {m.planned && <p class="label flag">{d.planned}: {d.plannedNote}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  /* A drawing register: one sheet per layer, package names in mono because they are code. */
  .layer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm) var(--gap-columns);
    padding-block: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .layer.planned {
    border-top-style: dashed;
  }

  li {
    padding-block: var(--space-sm);
  }

  li + li {
    border-top: var(--rule-hair) solid var(--color-rule-2);
  }

  .name {
    overflow-wrap: anywhere;
  }

  .text {
    margin-top: var(--space-2xs);
    color: var(--color-ink-2);
  }

  .flag {
    margin-top: var(--space-2xs);
  }

  @media (min-width: 48rem) {
    .layer {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }
</style>
