---
import { t, type Lang } from '@/i18n';
import type { Project } from '@/lib/content';

interface Props {
  modules: Project['data']['modules'];
  lang: Lang;
}

const { modules, lang } = Astro.props;
const d = t(lang).common;
const groups = Object.entries(Object.groupBy(modules, (m) => m.group));
---

<div class="map">
  {
    groups.map(([group, items = []]) => (
      <section class:list={['layer', 'reveal', { planned: items.every((m) => m.planned) }]}>
        <h3 class="mono">{group}</h3>
        <ul>
          {items.map((m) => (
            <li>
              <p class="name">{m.name}</p>
              <p class="muted">{m.description}</p>
              {m.planned && <p class="mono flag">{d.planned} — {d.plannedNote}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .map {
    display: grid;
    gap: 0.75rem;
  }

  .layer {
    display: grid;
    gap: 1rem 2rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .planned {
    background: none;
    border-style: dashed;
    border-left-color: var(--border-strong);
  }

  h3 {
    color: var(--text);
  }

  ul {
    display: grid;
    gap: 1.1rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .muted {
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .flag {
    margin-top: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--warm);
  }

  @media (min-width: 48rem) {
    .layer {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      padding: 1.5rem 1.75rem;
    }
  }
</style>
