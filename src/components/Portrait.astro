---
import { Picture } from 'astro:assets';
import portrait from '@/assets/jonathan-jimenez.webp';
import { t, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  /** CSS `sizes` for the rendered width. */
  sizes: string;
  eager?: boolean;
}

const { lang, sizes, eager = false } = Astro.props;
const d = t(lang);
---

<figure class="portrait">
  <div class="fig photo ticks">
    <Picture
      src={portrait}
      alt={d.portraitAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[240, 400, 640, 960]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
  <figcaption class="label">{SITE.name}, {d.location}</figcaption>
</figure>

<style>
  .portrait :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
</style>
