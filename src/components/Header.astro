---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import LangSwitch from './LangSwitch.astro';
import { NAV, href, t, type Lang, type PageKey } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page, sub } = Astro.props;
const d = t(lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href(lang, 'home')} aria-current={page === 'home' ? 'page' : undefined}>
      <span class="mark" aria-hidden="true">JJ</span>
      <span>{SITE.name}</span>
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="sr-only">{d.nav.menu}</span>
      <Menu class="icon-open" aria-hidden="true" />
      <X class="icon-close" aria-hidden="true" />
    </button>

    <nav id="site-nav" class="nav" aria-label={d.nav.main} data-menu>
      <ul>
        {
          NAV.map((key) => (
            <li>
              {/* On a detail page the parent section stays highlighted but is not "the current page". */}
              <a href={href(lang, key)} aria-current={page === key ? (sub ? 'true' : 'page') : undefined}>
                {d.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitch lang={lang} page={page} sub={sub} />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      menu.toggleAttribute('data-open', isOpen);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent);
    transition: border-color var(--fast) var(--ease);
  }

  .brand:hover .mark {
    border-color: var(--accent);
  }

  .nav,
  .nav ul {
    display: flex;
    align-items: center;
  }

  .nav {
    gap: 1.25rem;
  }

  .nav ul {
    gap: 0.25rem;
  }

  .nav li a {
    position: relative;
    display: block;
    padding: 0.5rem 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
    white-space: nowrap;
    transition: color var(--fast) var(--ease);
  }

  .nav li a:hover,
  .nav li a[aria-current] {
    color: var(--text);
  }

  /* Active indicator: a short rule under the link, not color alone. */
  .nav li a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.1rem;
    height: 1px;
    background: var(--accent);
  }

  .toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    background: none;
    border: 0;
    color: var(--text);
    cursor: pointer;
  }

  .toggle :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .toggle :global(.icon-close),
  .toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 72rem) {
    .toggle {
      display: grid;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      max-height: calc(100dvh - 4rem);
      overflow-y: auto;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .nav[data-open] {
      display: flex;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li a {
      padding: 0.95rem 0;
      font-size: 1.125rem;
      border-bottom: 1px solid var(--border);
    }

    .nav li a[aria-current]::after {
      left: 0;
      right: auto;
      top: 50%;
      bottom: auto;
      width: 0.5rem;
      margin-left: -1rem;
    }

    .nav :global(.lang) {
      align-self: flex-start;
    }
  }
</style>
