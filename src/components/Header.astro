---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import LangSwitch from './LangSwitch.astro';
import { NAV, href, t, type Lang, type PageKey } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page, sub } = Astro.props;
const d = t(lang);
// Open Source pages sit under Engineering in the header.
const isUnder = (key: PageKey) => page === 'openSource' && key === 'engineering';
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href(lang, 'home')} aria-current={page === 'home' ? 'page' : undefined}>
      {SITE.name}
    </a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="sr-only">{d.nav.menu}</span>
      <Menu class="icon-open" aria-hidden="true" />
      <X class="icon-close" aria-hidden="true" />
    </button>

    <nav id="site-nav" class="nav" aria-label={d.nav.main} data-menu>
      <ul>
        {
          NAV.map((key) => (
            <li>
              {/* On a detail page the parent section stays highlighted but is not "the current page". */}
              <a href={href(lang, key)} aria-current={page === key ? (sub ? 'true' : 'page') : isUnder(key) ? 'true' : undefined}>
                {d.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitch lang={lang} page={page} sub={sub} />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      menu.toggleAttribute('data-open', isOpen);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* One bar a step darker than the page, a hairline under it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-bar, var(--color-paper-3));
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 72px;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-display);
    text-transform: var(--head-case, none);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--color-ink-2);
  }

  .nav,
  .nav ul {
    display: flex;
    align-items: center;
  }

  .nav {
    gap: var(--space-lg);
  }

  .nav ul {
    gap: var(--space-lg);
  }

  .nav li a {
    display: flex;
    align-items: center;
    min-height: 72px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 0 0 0 var(--color-ink);
  }

  .nav li a:hover {
    color: var(--color-ink);
  }

  /* Current section: the line itself, drawn heavier at the bar's foot. */
  .nav li a[aria-current] {
    color: var(--color-ink);
    box-shadow: inset 0 -2px 0 0 var(--color-current, var(--color-ink));
  }

  .toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    background: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    cursor: pointer;
  }

  .toggle:hover {
    background: var(--color-paper);
  }

  .toggle:active {
    transform: translateY(1px);
  }

  .toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .toggle :global(.icon-close),
  .toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  @media (max-width: 68rem) {
    .toggle {
      display: grid;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-lg);
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      padding: var(--space-xs) var(--gutter) var(--space-lg);
      background: var(--color-bar, var(--color-paper-3));
      border-bottom: var(--rule-heavy) solid var(--color-rule);
    }

    .nav[data-open] {
      display: flex;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav li a {
      min-height: 56px;
      font-size: var(--text-lg);
      border-bottom: var(--rule-hair) solid var(--color-rule-2);
    }

    .nav li a[aria-current] {
      box-shadow: inset 2px 0 0 0 var(--color-current, var(--color-ink));
      padding-left: var(--space-md);
    }

    .nav :global(.lang) {
      align-self: flex-start;
    }
  }
</style>
