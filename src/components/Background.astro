---
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { education, languages } = t(Astro.props.lang);
---

<table class="background">
  <tbody>
    <tr>
      <th colspan="3" scope="rowgroup">{education.title}</th>
    </tr>
    {
      education.items.map((item) => (
        <tr>
          <td class="school">{item.school}</td>
          <td>{item.detail}</td>
          <td class="num">{item.period}</td>
        </tr>
      ))
    }
  </tbody>
  <tbody>
    <tr>
      <th colspan="3" scope="rowgroup">{languages.title}</th>
    </tr>
    {
      languages.items.map((item) => (
        <tr>
          <td class="school">{item.name}</td>
          <td colspan="2">{item.level}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  /* A register: two groups of rows on one sheet. */
  .background {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    padding-block: var(--space-xl) var(--space-sm);
    border-bottom: var(--rule-heavy) solid var(--color-rule);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-display);
  }

  tbody:first-child th {
    padding-top: 0;
  }

  td {
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
    vertical-align: baseline;
    color: var(--color-ink-2);
  }

  .school {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
  }

  .num {
    white-space: nowrap;
  }

  /* On a phone each row restacks as a block. */
  @media (max-width: 40rem) {
    tr,
    td,
    th {
      display: block;
    }

    td {
      padding-block: var(--space-2xs);
      border-bottom: 0;
    }

    tr {
      padding-block: var(--space-sm);
      border-bottom: var(--rule-hair) solid var(--color-rule-2);
    }

    tr:has(th) {
      padding-block: 0;
      border-bottom: 0;
    }
  }
</style>
