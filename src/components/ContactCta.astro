---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ExtLink from './ExtLink.astro';
import { href, t, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.cta.title;
---

<section class="cta">
  <div class="container inner">
    <p class="mono reveal">{d.cta.label}</p>
    <h2 class="reveal">{title}</h2>
    <p class="lead reveal">{d.cta.text}</p>
    <p class="reveal"><a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <p class="links reveal">
      <a class="link" href={href(lang, 'contact')}>{d.cta.primary}<ArrowRight aria-hidden="true" /></a>
      <ExtLink href={SITE.linkedin} lang={lang} class="link">LinkedIn</ExtLink>
      <ExtLink href={SITE.github} lang={lang} class="link">GitHub</ExtLink>
    </p>
  </div>
</section>

<style>
  .cta {
    border-top: 1px solid var(--border);
    padding-block: var(--space-section);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    justify-items: start;
  }

  h2 {
    font-size: var(--text-3xl);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  /* The address is the call to action: set as type, not as a button. */
  .mail {
    display: inline-block;
    margin-top: 1rem;
    padding-bottom: 0.2em;
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--accent);
    transition: color var(--fast) var(--ease);
  }

  .mail:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-size: var(--text-sm);
  }
</style>
