---
import ExtLink from './ExtLink.astro';
import { href, t, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.cta.title;
---

<section class="cta band">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{d.cta.text}</p>
    </div>
    <div class="act">
      <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p class="links">
        <a class="link" href={href(lang, 'contact')}>{d.cta.primary}</a>
        <ExtLink href={SITE.linkedin} lang={lang} class="link">LinkedIn</ExtLink>
        <ExtLink href={SITE.github} lang={lang} class="link">GitHub</ExtLink>
      </p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: end;
  }

  h2 {
    max-width: 18ch;
    text-wrap: balance;
  }

  .lead {
    margin-top: var(--space-lg);
    color: var(--color-ink-2);
  }

  .act {
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  /* The address is the action: set at the title size on its own line. */
  .mail {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .mail {
      font-size: var(--text-title);
    }
  }

  .mail:hover {
    text-decoration-color: transparent;
  }

  .mail:active {
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
