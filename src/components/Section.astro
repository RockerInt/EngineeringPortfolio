---
interface Props {
  /** The section's plain name: it is the heading. */
  label: string;
  /** One line under the heading. */
  title?: string;
  id?: string;
  /** A register sheet: one step darker. */
  band?: boolean;
}

const { label, title, id, band = false } = Astro.props;
---

<section class:list={['section', { band }]} id={id}>
  <div class="container">
    <header class="head">
      <h2>{label}</h2>
      {title && <p class="lead">{title}</p>}
    </header>
    <slot />
  </div>
</section>
