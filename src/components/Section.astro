---
interface Props {
  label: string;
  title?: string;
  id?: string;
}

const { label, title, id } = Astro.props;
// Every section needs a heading: without a title, the rail label takes that role.
const Label = title ? 'p' : 'h2';
---

<section class="section" id={id}>
  <div class="container section-grid">
    <div class="section-rail">
      <Label class="section-label mono">{label}</Label>
      <slot name="rail" />
    </div>
    <div>
      {title && <h2 class="section-title reveal">{title}</h2>}
      <slot />
    </div>
  </div>
</section>
