---
import Status from './Status.astro';
import type { Lang } from '@/i18n';
import { projectHref, type Project } from '@/lib/content';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
  /** Optional editorial note shown instead of the summary. */
  note?: string;
  level?: 3 | 4;
}

const { project, lang, index, note, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
const { title, summary, category, stack } = project.data;
---

<li>
  <a class="row" href={projectHref(lang, project)}>
    <span class="num idx" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    <div class="body">
      <Heading class="title">{title}</Heading>
      <p>{note ?? summary}</p>
    </div>
    <div class="meta">
      <span class="label">{category}</span>
      <Status project={project} lang={lang} />
      <span class="stack">{stack.slice(0, 5).join(', ')}</span>
    </div>
  </a>
</li>

<style>
  li {
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
  }

  /* A register row: the whole line links, and darkens one step on hover. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md) var(--gap-columns);
    padding: var(--space-lg) var(--space-md);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .row:hover {
    background: var(--color-paper-3);
  }

  .row:active {
    background: var(--color-paper-2);
  }

  .idx {
    font-size: var(--text-xl);
  }

  /* The title carries the link's underline, cleared on hover like every link. */
  .title {
    font-size: var(--text-head);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .row:hover .title {
    text-decoration-color: transparent;
  }

  .body p {
    margin-top: var(--space-sm);
    max-width: 58ch;
    color: var(--color-ink-2);
  }

  .meta {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    font-size: var(--text-sm);
  }

  .stack {
    color: var(--color-ink-2);
  }

  @media (min-width: 60rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 7fr) minmax(0, 4fr);
      padding-block: var(--space-xl);
    }
  }
</style>
