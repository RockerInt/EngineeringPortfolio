---
import { href, otherLang, t, type Lang, type PageKey } from '@/i18n';

interface Props {
  lang: Lang;
  page?: PageKey;
  sub?: string;
}

const { lang, page = 'home', sub } = Astro.props;
const target = otherLang(lang);
const d = t(lang);
---

<a class="lang" href={href(target, page, sub)} hreflang={target} lang={target}>
  <span aria-hidden="true">{d.nav.switchTo}</span>
  <span class="sr-only">{d.nav.switchLabel}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-micro) var(--ease-out);
  }

  .lang:hover {
    background: var(--color-paper);
  }

  .lang:active {
    transform: translateY(1px);
  }
</style>
