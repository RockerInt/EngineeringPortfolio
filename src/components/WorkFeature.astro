---
import { Picture } from 'astro:assets';
import ExtLink from './ExtLink.astro';
import { t, type Lang } from '@/i18n';
import { projectHref, type Project } from '@/lib/content';

interface Props {
  project: Project;
  lang: Lang;
  /** Larger layout with image and text side by side. */
  wide?: boolean;
  eager?: boolean;
  level?: 2 | 3 | 4;
}

const { project, lang, wide = false, eager = false, level } = Astro.props;
const { title, summary, category, url, cover, coverAlt, role } = project.data;
const d = t(lang).common;
const detail = projectHref(lang, project);
const host = url ? new URL(url).host : undefined;
// Wide features sit directly under the page <h1>; compact ones live inside a titled section.
const Heading = `h${level ?? (wide ? 2 : 3)}` as const;
---

<article class:list={['feature', { wide }]}>
  {
    cover && (
      <figure class="shot">
        <a href={detail} class="fig ticks" tabindex="-1" aria-hidden="true">
          <Picture
            src={cover}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 800, 1200, 1600]}
            sizes={wide ? '(min-width: 60rem) 60vw, 100vw' : '(min-width: 60rem) 45vw, 100vw'}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
          />
        </a>
        {host && <figcaption class="num">{host}</figcaption>}
      </figure>
    )
  }
  <div class="text">
    <Heading class="title"><a href={detail}>{title}</a></Heading>
    <p class="label">{category}</p>
    <p class="summary">{summary}</p>
    {role && wide && <p class="label">{d.role}: {role}</p>}
    <p class="links">
      <a class="link" href={detail} aria-label={`${d.caseStudy}: ${title}`}>{d.caseStudy}</a>
      {url && <ExtLink href={url} lang={lang} class="link">{d.visitSite}</ExtLink>}
    </p>
    {cover && coverAlt && <p class="sr-only">{coverAlt}</p>}
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg) var(--space-2xl);
    align-content: start;
  }

  .wide {
    align-items: center;
  }

  .fig {
    display: block;
  }

  /* One crop for every capture, from the top of the page it shows. */
  .fig :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .fig:hover {
    background: var(--color-paper-2);
  }

  figcaption {
    margin-top: var(--space-sm);
    color: var(--color-muted);
  }

  .text {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
  }

  .title {
    font-size: var(--text-2xl);
  }

  .wide .title {
    font-size: var(--text-head);
  }

  .wide h2.title {
    max-width: none;
    font-size: var(--text-section);
    text-wrap: balance;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .summary {
    color: var(--color-ink-2);
  }

  .links {
    margin-top: var(--space-sm);
  }

  @media (min-width: 60rem) {
    .wide {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .wide:nth-child(even) {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }
  }
</style>
