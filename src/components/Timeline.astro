---
import { render } from 'astro:content';
import ExtLink from './ExtLink.astro';
import { href, t, type Lang } from '@/i18n';
import { getJobs } from '@/lib/content';

interface Props {
  lang: Lang;
  /** Compact rows (home, résumé) versus full entries with projects and stack. */
  compact?: boolean;
  /** Heading level for each organization in the full layout. */
  level?: 2 | 3;
}

const { lang, compact = false, level = 2 } = Astro.props;
const Org = `h${level}` as const;
const d = t(lang);
// The open-ended period is the current role; it gets the single accent dot.
const isCurrent = (period?: string) => /Present/.test(period ?? '');
const jobs = await Promise.all((await getJobs(lang)).map(async (job) => ({ job, Content: (await render(job)).Content })));
---

{
  compact ? (
    <ol class="rows register">
      {jobs.map(({ job }) => (
        <li class:list={{ now: isCurrent(job.data.period) }}>
          <p class="num when">{job.data.period}</p>
          <p class="org">{job.data.org}</p>
          <p class="role">{job.data.role}</p>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="entries register">
      {jobs.map(({ job, Content }) => (
        <li class="entry">
          <div class="when">
            {job.data.period && <p class:list={['num', 'period', { now: isCurrent(job.data.period) }]}>{job.data.period}</p>}
            {job.data.location && <p class="label">{job.data.location}</p>}
          </div>
          <article>
            <Org class="org-title">{job.data.org}</Org>
            <p class="role">{job.data.role}</p>
            <div class="summary"><Content /></div>
            {job.data.projects.length > 0 && (
              <dl class="projects" aria-label={d.experience.projects}>
                {job.data.projects.map((p) => (
                  <div>
                    <dt>{p.name}</dt>
                    <dd>{p.description}</dd>
                  </div>
                ))}
              </dl>
            )}
            <ul class="tags" aria-label={d.common.stack}>
              {job.data.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
            {(job.data.caseStudy || job.data.url) && (
              <p class="case links">
                {job.data.caseStudy && (
                  <a class="link" href={href(lang, 'engineering', job.data.caseStudy)}>{d.experience.relatedCase}</a>
                )}
                {job.data.url && (
                  <ExtLink href={job.data.url} lang={lang} class="link">{new URL(job.data.url).host}</ExtLink>
                )}
              </p>
            )}
          </article>
        </li>
      ))}
    </ol>
  )
}

<style>
  /* Compact: a register of posts, the period in its own mono column. */
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs) var(--gap-columns);
    padding-block: var(--space-lg);
    align-items: baseline;
  }

  /* The current post: its period in the signal colour. */
  .now .when,
  .entry .period.now {
    color: var(--color-current, var(--color-ink));
  }

  .org {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-display);
    max-width: none;
  }

  .rows .role {
    color: var(--color-ink-2);
  }

  .when {
    color: var(--color-ink-2);
  }

  @media (min-width: 48rem) {
    .rows li {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    }
  }

  /* Full entries */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md) var(--gap-columns);
    padding-block: var(--space-2xl);
  }

  .entry:first-child {
    padding-top: var(--space-lg);
  }

  h2.org-title {
    font-size: var(--text-section);
  }

  .entry .when {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  .period {
    font-size: var(--text-md);
    color: var(--color-ink);
  }

  .org-title {
    max-width: none;
    font-size: var(--text-head);
    text-transform: none;
    line-height: 1.1;
    text-wrap: balance;
  }

  .entry .role {
    margin-top: var(--space-xs);
    font-size: var(--text-lead);
    font-weight: 500;
  }

  .summary {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
  }

  .summary :global(p) {
    max-width: 65ch;
  }

  .projects {
    margin-top: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
  }

  .projects > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-lg);
    padding: var(--space-sm) var(--space-md);
  }

  .projects > div + div {
    border-top: var(--rule-hair) solid var(--color-rule-2);
  }

  .projects dt {
    font-weight: 500;
  }

  .projects dd {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .entry .tags,
  .case {
    margin-top: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .projects > div {
      grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    }
  }

  @media (min-width: 60rem) {
    .entry {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
  }
</style>
